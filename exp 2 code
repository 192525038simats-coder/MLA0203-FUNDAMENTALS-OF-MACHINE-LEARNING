import csv

# Create a CSV file
data = [
    ['Sunny', 'Warm', 'Normal', 'Strong', 'Warm', 'Same', 'Yes'],
    ['Sunny', 'Warm', 'High', 'Strong', 'Warm', 'Same', 'Yes'],
    ['Rainy', 'Cold', 'High', 'Strong', 'Warm', 'Change', 'No'],
    ['Sunny', 'Warm', 'High', 'Strong', 'Cool', 'Change', 'Yes']
]

with open("training_data.csv", "w", newline="") as f:
    writer = csv.writer(f)
    writer.writerow(['Sky', 'AirTemp', 'Humidity', 'Wind',
                     'Water', 'Forecast', 'EnjoySport'])
    writer.writerows(data)

# Candidate-Elimination Algorithm
S = ['0'] * 6
G = [['?'] * 6]

for row in data:
    x = row[:-1]
    target = row[-1]

    if target == 'Yes':
        G = [g for g in G if all(
            g[i] == '?' or g[i] == x[i] for i in range(6)
        )]

        for i in range(6):
            if S[i] == '0':
                S[i] = x[i]
            elif S[i] != x[i]:
                S[i] = '?'

    else:
        new_G = []
        for g in G:
            if all(g[i] == '?' or g[i] == x[i] for i in range(6)):
                for i in range(6):
                    if S[i] != '0' and S[i] != '?' and S[i] != x[i]:
                        h = g.copy()
                        h[i] = S[i]
                        new_G.append(h)
            else:
                new_G.append(g)
        G = new_G

    print("S =", S)
    print("G =", G)

print("\nFinal Specific Boundary:", S)
print("Final General Boundary:", G)
